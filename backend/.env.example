# Backend Environment Variables

# Required - OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Required - Firebase Configuration (copy from your Firebase console)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY_ID=your_private_key_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=your_service_account_email
FIREBASE_CLIENT_ID=your_client_id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token

# Optional - Game Configuration (defaults provided)
MAX_GUESSES=6
MIN_WORD_LENGTH=4
MAX_WORD_LENGTH=5
TARGET_AGE_MIN=8
TARGET_AGE_MAX=13
RECENT_WORDS_LIMIT=50
SENTENCE_MIN_WORDS=5
SENTENCE_MAX_WORDS=7

# Optional - Word Blocklist (comma-separated)
WORD_BLOCKLIST=death,crime,blood,ghost,scary

# Optional - CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://your-frontend-domain.vercel.app
FRONTEND_URL=https://your-frontend-domain.vercel.app

# Optional - System Prompt
SYSTEM_PROMPT=You are an educational assistant for a Wordle game designed for kids. Your answers should be kid-friendly, engaging, and educational. Always provide clear, concise responses.

# Development
NODE_ENV=development