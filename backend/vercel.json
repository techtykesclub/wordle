{
  "version": 2,
  "name": "wordle-game-backend",
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/health",
      "dest": "/api/health.js"
    },
    {
      "src": "/test",
      "dest": "/api/index.js"
    },
    {
      "src": "/test-post",
      "dest": "/api/index.js"
    },
    {
      "src": "/openai/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "regions": ["iad1"]
}
